# App
NODE_ENV=development
PORT=5000
API_PREFIX=api
# Database
MONGODB_URI=mongodb://127.0.0.1:27017/sbr_real_estate
# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# JWT (replace both values with distinct, cryptographically random secrets)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d
# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Local email inbox (docker-compose.local.yml); UI: http://localhost:8025
# For real SMTP use SMTP_AUTH_ENABLED=true and supply provider credentials.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_AUTH_ENABLED=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sbr.local
# General throttle settings (auth endpoints use stricter route-specific Redis limits)
THROTTLE_TTL=60
THROTTLE_LIMIT=100
# Frontend URL (comma-separated exact origins supported)
FRONTEND_URL=http://localhost:3000

# Authentication
APP_URL=http://localhost:3000
JWT_ISSUER=sbr-real-estate
JWT_AUDIENCE=sbr-web
AUTH_COOKIE_SAME_SITE=lax
# Exact trusted reverse-proxy hop count; leave zero without a proxy
TRUST_PROXY_HOPS=0
